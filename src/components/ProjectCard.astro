---
import type { projects } from '../data/site';
import { getProjectOutputs } from '../lib/outputs';
import ProjectVideo from './ProjectVideo.astro';
interface Props { project: (typeof projects)[number]; index: number; }
const { project, index } = Astro.props;
const outputs = await getProjectOutputs(project.id);
const video = project.videos[0];
---

<article class="project-card" id={project.id} data-topic={project.topic}>
  <div class="project-media">
    <ProjectVideo video={video} label={`${project.title}: ${video.title}`} />
  </div>
  <div class="project-caption">
    <span class="eyebrow">Project {String(index + 1).padStart(2, '0')} / {project.topic}</span>
    <h2><a href={`/projects/${project.id}/`}>{project.title}</a></h2>
    <p>{project.description}</p>
    {project.videos.length > 1 && <a class="text-link" href={`/projects/${project.id}/#demonstration-heading`}>View all {project.videos.length} videos →</a>}
    {outputs.length > 0 && <div class="project-outputs"><span class="eyebrow">Related outputs ({outputs.length})</span><ul>{outputs.slice(0, 3).map((entry) => <li><a href={`/publications/#output-${entry.id}`}>{entry.data.title}</a></li>)}</ul></div>}
    <a class="text-link" href={`/projects/${project.id}/`}>Explore project & outputs →</a>
  </div>
</article>
