---
import type { ProjectVideo } from '../data/site';
import VideoPlayer from './ProjectVideo.astro';
interface Props { videos: ProjectVideo[]; }
const { videos } = Astro.props;
---
<div class:list={['video-gallery', { 'multiple-videos': videos.length > 1 }]}>
  {videos.map((video, index) => (
    <figure>
      <div class="project-media">
        <VideoPlayer video={video} />
      </div>
      <figcaption>
        <span class="eyebrow">Video {String(index + 1).padStart(2, '0')}</span>
        <h3>{video.title}</h3>
        <p>{video.caption}</p>
      </figcaption>
    </figure>
  ))}
</div>
<style>
  .video-gallery { display: grid; gap: 32px; margin-top: 24px; max-width: 800px; }
  .multiple-videos { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: none; }
  figure { margin: 0; min-width: 0; }
  figcaption { padding-top: 16px; }
  h3 { margin: 6px 0; font-size: 21px; }
  p { margin: 0; color: var(--muted); font-size: 15px; }
  @media (max-width: 700px) { .multiple-videos { grid-template-columns: 1fr; } }
</style>
