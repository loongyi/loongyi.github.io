---
import SiteLayout from '../layouts/SiteLayout.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/profile-original.jpg';
import ProfileLinks from '../components/ProfileLinks.astro';
import ProjectCard from '../components/ProjectCard.astro';
import OutputCard from '../components/OutputCard.astro';
import { getVisibleOutputs } from '../lib/outputs';
import { news, profiles, projects, site } from '../data/site';
const updates = [...news].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 5);
const dateFormat = new Intl.DateTimeFormat('en', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const hasProfiles = profiles.some((profile) => profile.href.trim());
const latestOutputs = (await getVisibleOutputs()).slice(0, 3);
---
<SiteLayout title="Home">
  <section class="home-intro" aria-labelledby="profile-heading">
    <div class="profile-intro">
      <p class="eyebrow"><em>Welcome to my personal site. Thank you for visiting.</em></p>
      <div class="profile-identity">
        <div class="profile-portrait">
          <Image src={portrait} width={640} format="webp" quality={80} alt={`Portrait of ${site.author}`} loading="eager" />
        </div>
        <div class="profile-identity-text">
          <h1 id="profile-heading">{site.author || 'Your name'}</h1>
          <p class="profile-affiliation">{[site.role, site.affiliation].filter(Boolean).join(' · ') || 'Robotics & embodied intelligence'}</p>
        </div>
      </div>
      <p class="profile-bio">{site.bio}</p>
      <div class="profile-interests"><span class="eyebrow">Research interests</span><p>Embodied Intelligence · Soft Robotics · Robot Manipulation · Design Optimization</p></div>
      <section class="contact-block" aria-labelledby="contact-heading">
        <h2 id="contact-heading">Contact & links</h2>
        {hasProfiles ? <ProfileLinks showLabels /> : <p class="muted">Contact details and academic profiles will be added soon.</p>}
        <!-- <div class="profile-shortcuts"><a class="text-link" href="/publications/">Publications →</a><a class="text-link" href="/projects/">Projects →</a><a class="text-link" href="/blog/">Research notes →</a></div>-->
      </section>
    </div>
    <aside class="news-panel" aria-labelledby="news-heading">
      <p class="eyebrow">Exciting things ahead (probably...)</p>
      <h2 id="news-heading">News & updates</h2>
      {updates.length > 0 ? (
        <ol class="news-feed">
          {updates.map((update) => (
            <li>
              <time datetime={update.date}>{dateFormat.format(new Date(`${update.date}T00:00:00Z`))}</time>
              <p>{update.text}</p>
              {update.href && <a class="text-link" href={update.href}>{update.linkLabel || 'Read more'} →</a>}
            </li>
          ))}
        </ol>
      ) : (
        <div class="news-empty"><p>No announcements just yet.</p><p class="muted">Check back for publications, project milestones, talks, and other news.</p></div>
      )}
      <a class="text-link" href="/blog/">Visit the notebook →</a>
    </aside>
  </section>
  <div class="research-divider"><p>Bringing Robots Closer to <em>Our Living Environment.</em></p><a class="text-link" href="/research/">Research themes →</a></div>
  <section class="section" aria-labelledby="experiments-heading">
    <div class="section-heading"><div><h2 id="experiments-heading">Select Research Projects</h2></div><a class="text-link" href="/projects/">All projects ↗</a></div>
    <div class="project-grid">{projects.map((project, index) => <ProjectCard project={project} index={index} />)}</div>
  </section>
  {latestOutputs.length > 0 && (
    <>
      <section class="section" aria-labelledby="latest-outputs-heading">
        <div class="section-heading">
          <div>
            <h2 id="latest-outputs-heading">Recent Research Output</h2>
          </div>
          <a class="text-link" href="/publications/">All research output ↗</a>
        </div>
        {latestOutputs.map((entry) => <OutputCard entry={entry} compact />)}
      </section>
    </>
  )}
  <section class="explore-grid" aria-label="Explore the site">
    <a href="/research/"><h2>The big questions ↗</h2><p>Research themes and directions.</p></a>
    <a href="/publications/"><h2>Research output ↗</h2><p>Publications and communications.</p></a>
    <a href="/blog/"><h2>From the notebook ↗</h2><p>Updates, notes, and occasional musings.</p></a>
  </section>
</SiteLayout>
