---
import SiteLayout from '../../layouts/SiteLayout.astro';
import OutputCard from '../../components/OutputCard.astro';
import ProjectVideos from '../../components/ProjectVideos.astro';
import { projects } from '../../data/site';
import { getProjectOutputs } from '../../lib/outputs';
export function getStaticPaths() {
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}
const { project } = Astro.props;
const outputs = await getProjectOutputs(project.id);
const tags = [...new Set(outputs.flatMap(({ data }) => data.tags))].sort();
---
<SiteLayout title={project.title} description={project.description}>
  <header class="page-heading">
    <a class="text-link" href="/projects/">← All research projects</a>
    <p class="eyebrow">{project.topic}</p>
    <h1>{project.title}</h1>
    <p class="lead">{project.description}</p>
    {tags.length > 0 && <div class="output-tags" aria-label="Research topics">{tags.map((tag) => <a href={`/publications/?tag=${encodeURIComponent(tag)}`}>#{tag}</a>)}</div>}
  </header>
  <section class="section" aria-labelledby="demonstration-heading">
    <h2 id="demonstration-heading">Experiments in motion</h2>
    <ProjectVideos videos={project.videos} />
  </section>
  <section class="section" aria-labelledby="related-heading">
    <div class="section-heading"><div><p class="eyebrow">Publications & resources</p><h2 id="related-heading">Related outputs ({outputs.length})</h2></div><a class="text-link" href="/publications/">All research output →</a></div>
    {outputs.length > 0 ? outputs.map((entry) => <OutputCard entry={entry} />) : <p class="muted">Related publications and resources will be added here.</p>}
  </section>
</SiteLayout>
