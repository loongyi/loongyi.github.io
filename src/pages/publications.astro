---
import SiteLayout from '../layouts/SiteLayout.astro';
import OutputCard from '../components/OutputCard.astro';
import { getVisibleOutputs } from '../lib/outputs';
import { outputStatuses } from '../data/output-statuses';
import { outputTypes, outputTypeLabels } from '../data/output-types';
import { projects } from '../data/site';
import '../styles/output-directory.css';
const outputs = await getVisibleOutputs();
const statuses = outputStatuses.map((status) => ({status, count: outputs.filter(({data}) => data.status === status).length})).filter(({count}) => count > 0);
const tags = [...new Set(outputs.flatMap(({ data }) => data.tags))].sort();
const linkedProjects = projects.filter((project) => outputs.some(({ data }) => data.projects.includes(project.id)));
const categories = outputTypes.map((type) => ({
  type,
  label: outputTypeLabels[type],
  count: outputs.filter(({ data }) => data.type === type).length,
})).filter(({ count }) => count > 0);
---
<SiteLayout title="Research Output" description="Publications, talks, software, and other research outputs.">
  <div class="output-directory">
  <header class="page-heading"><h1>Research output</h1><p class="lead">Publications, communications, and resources from research.</p></header>
  {outputs.length > 0 ? (
    <section aria-label="Research outputs">
      <div class="output-controls" hidden>
        <div>
          <label for="output-type">Output category</label>
          <select id="output-type" aria-controls="output-results">
            <option value="">All outputs ({outputs.length})</option>
            {categories.map(({ type, label, count }) => <option value={type}>{label} ({count})</option>)}
          </select>
        </div>
        <div class="output-search-field"><label for="output-search">Search outputs</label><input id="output-search" type="search" placeholder="Title, author, venue, or year" /></div>
        <div><label for="output-status">Output status</label><select id="output-status"><option value="">All statuses</option>{statuses.map(({status, count}) => <option value={status}>{status} ({count})</option>)}</select></div>
        {tags.length > 0 && <div><label for="output-tag">Research topic</label><select id="output-tag"><option value="">All topics</option>{tags.map((tag) => <option value={tag}>{tag}</option>)}</select></div>}
        {linkedProjects.length > 0 && <div><label for="output-project">Research project</label><select id="output-project"><option value="">All projects</option>{linkedProjects.map((project) => <option value={project.id}>{project.title}</option>)}</select></div>}
        <button class="output-reset" type="button">Clear all filters</button>
      </div>
      <p class="muted" id="output-count" role="status" aria-live="polite">{outputs.length} {outputs.length === 1 ? 'output' : 'outputs'}</p>
      <div class="output-list" id="output-results">
      {outputs.map((entry) => <OutputCard entry={entry} />)}
      <p class="empty-state" id="output-no-results" hidden>No matching outputs. Try another search or clear all filters.</p>
      </div>
    </section>
  ) : (
    <section class="empty-state"><span class="eyebrow">Research output</span><h2>Publications and resources are being added.</h2><p>In the meantime, explore the current research and experiments.</p><a class="text-link" href="/projects/">View projects →</a></section>
  )}
  </div>
</SiteLayout>
<script>
  const controls = document.querySelector<HTMLElement>('.output-controls');
  const search = document.querySelector<HTMLInputElement>('#output-search');
  const status = document.querySelector<HTMLSelectElement>('#output-status');
  const tag = document.querySelector<HTMLSelectElement>('#output-tag');
  const project = document.querySelector<HTMLSelectElement>('#output-project');
  const reset = document.querySelector<HTMLButtonElement>('.output-reset');
  const type = document.querySelector<HTMLSelectElement>('#output-type');
  const cards = document.querySelectorAll<HTMLElement>('[data-output]');
  const count = document.querySelector('#output-count');
  const empty = document.querySelector<HTMLElement>('#output-no-results');
  function filterOutputs() {
    const terms = (search?.value ?? '').trim().toLowerCase().split(/\s+/).filter(Boolean);
    let visible = 0;
    cards.forEach((card) => {
      card.hidden = !terms.every((term) => card.dataset.search?.includes(term)) || (!!type?.value && card.dataset.type !== type.value) || (!!status?.value && card.dataset.status !== status.value)
        || (!!tag?.value && !JSON.parse(card.dataset.tags || '[]').includes(tag.value))
        || (!!project?.value && !JSON.parse(card.dataset.projects || '[]').includes(project.value));
      if (!card.hidden) visible++;
    });
    if (count) count.textContent = `${visible} ${visible === 1 ? 'output' : 'items'}`;
    if (empty) empty.hidden = visible > 0;
  }
  if (controls) controls.hidden = false;
  search?.addEventListener('input', filterOutputs);
  status?.addEventListener('change', filterOutputs);
  function updateTopicUrl() {
    const url = new URL(window.location.href);
    for (const [key, value] of [['type', type?.value], ['tag', tag?.value], ['project', project?.value]]) {
      if (value) url.searchParams.set(key!, value);
      else url.searchParams.delete(key!);
    }
    window.history.replaceState(null, '', url);
    filterOutputs();
  }
  tag?.addEventListener('change', updateTopicUrl);
  type?.addEventListener('change', updateTopicUrl);
  project?.addEventListener('change', updateTopicUrl);
  reset?.addEventListener('click', () => {
    if (search) search.value = '';
    for (const select of [type, status, tag, project]) if (select) select.value = '';
    updateTopicUrl();
  });
  const params = new URLSearchParams(window.location.search);
  for (const [key, select] of [['type', type], ['tag', tag], ['project', project]] as const) {
    const value = params.get(key);
    if (select && value && Array.from(select.options).some((option) => option.value === value)) select.value = value;
  }
  filterOutputs();
</script>
